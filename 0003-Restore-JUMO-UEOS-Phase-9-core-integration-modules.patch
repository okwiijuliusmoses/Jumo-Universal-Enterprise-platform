diff --git a/experience/public/experience/services/apiClient.js b/experience/public/experience/services/apiClient.js
index 55dc58b..fd511ca 100644
--- a/experience/public/experience/services/apiClient.js
+++ b/experience/public/experience/services/apiClient.js
@@ -54,13 +54,40 @@ class JumoApiClient {
   }
 
   // Identity & Auth
-  async login(email, role = 'SecOps_Administrator') {
-    // Standard mock session handler for experience layer authentication flow
+  async login(email, role = 'SecOps_Administrator', tenantId = 'Global') {
+    try {
+      // Attempt real server login with dual-contract endpoints
+      const response = await this.request('/api/v1/ueos/identity/login', {
+        method: 'POST',
+        body: JSON.stringify({
+          username: email,
+          password: 'password123',
+          tenant: tenantId
+        })
+      });
+      if (response && response.success) {
+        const user = {
+          email,
+          name: email.split('@')[0],
+          role: response.session.user.role,
+          tenantId: response.session.user.tenant,
+          trustLevel: 'L4_High_Trust',
+          token: response.session.token
+        };
+        localStorage.setItem('jumo_current_user', JSON.stringify(user));
+        localStorage.setItem('jumo_session_token', response.session.token);
+        return { success: true, user };
+      }
+    } catch (err) {
+      console.warn('Backend identity bridge offline or deferred. Falling back to local state management.', err);
+    }
+
+    // Standard mock session handler fallback for experience layer authentication flow
     const mockUser = {
       email,
       name: email.split('@')[0],
       role,
-      tenantId: 'JUMO-HQ-01',
+      tenantId: tenantId || 'JUMO-HQ-01',
       trustLevel: 'L4_High_Trust',
     };
     localStorage.setItem('jumo_current_user', JSON.stringify(mockUser));
