-            ...x,
-            allocated_amount_minor: x.amount_minor,
-            status: "PAID"
-          })
-        );
-      } else {
-        // Remittance partially covers this item
-        const partialAllocation = remainingRemittance;
-        remainingRemittance = 0;
-        totalAllocated += partialAllocation;
-
-        allocatedItems.push({
-          openItemId: item.id,
-          allocatedAmountMinor: partialAllocation,
-          status: "PARTIALLY_PAID"
-        });
-
-        this.db.update<any>(
-          "open_items",
