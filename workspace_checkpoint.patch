-// ============================================================================
-// PHASE 3: POLYMORPHIC WEBHOOK ALLOCATION ENGINE
-// ============================================================================
-
-import * as crypto from "crypto";
-import { JUMODBEngine } from "./database/db";
-import { BalancerService, LineInput } from "./02_balancer.service";
-
-/**
- * Interface representing the payment aggregator webhook payload.
- */
-export interface WebhookPayload {
-  tenantId: string;
-  partyId: string;
-  remittanceAmountMinor: number; // Integer BIGINT
-  currency: string;
-  externalReference: string;
-  clearingAccountId: string;     // The asset account receiving cash transit
-  receivablesAccountId: string;  // The receivables asset account being credited
-  walletAccountId?: string;      // Optional, custom wallet account id
-}
-
-/**
- * Interface representing the itemized allocation result.
- */
-export interface AllocatedItem {
-  openItemId: string;
-  allocatedAmountMinor: number;
-  status: "PAID" | "PARTIALLY_PAID";
-}
-
-/**
- * Interface representing the final response after processing the webhook.
- */
-export interface AllocationResult {
-  success: boolean;
-  message: string;
-  journalEntryId: string;
-  allocatedAmountMinor: number;
-  overflowAmountMinor: number;
-  allocatedItems: AllocatedItem[];
-  walletCredited: boolean;
-}
-
-/**
- * PolymorphicAllocationEngine processes B2B SaaS webhooks, verifies HMAC signatures,
- * guards against double-spending using idempotency filters, and runs FIFO matching on debts.
- */
-export class PolymorphicAllocationEngine {
-  private db: JUMODBEngine;
-
-  constructor() {
-    this.db = JUMODBEngine.getInstance();
-  }
-
-  /**
-   * Main entry point to process incoming payment aggregator webhook callback.
-   * 
-   * @param headers Express request headers for HMAC signature and timestamp matching
-   * @param rawBody Raw JSON request string for precise crypto signature validation
-   * @param secretKey Cryptographic secret key used to compute the HMAC
-   */
-  public async processWebhook(
-    headers: Record<string, string | string[] | undefined>,
-    rawBody: string,
-    secretKey: string
-  ): Promise<AllocationResult> {
-    const signatureHeader = headers["x-signature"];
-    const timestampHeader = headers["x-timestamp"];
-
-    if (!signatureHeader || typeof signatureHeader !== "string") {
-      throw new Error("Cryptographic Error: Missing or invalid x-signature header.");
-    }
-
-    if (!timestampHeader || typeof timestampHeader !== "string") {
-      throw new Error("Cryptographic Error: Missing or invalid x-timestamp header.");
-    }
-
-    // 1. Defend against replay attacks: ensure timestamp is within 5 minutes (300 seconds)
-    const requestTime = parseInt(timestampHeader, 10);
-    const currentTime = Math.floor(Date.now() / 1000);
-    if (isNaN(requestTime) || Math.abs(currentTime - requestTime) > 300) {
-      throw new Error("Cryptographic Error: Webhook replay protection failed. Timestamp deviation exceeded 5 minutes.");
-    }
-
-    // 2. Compute HMAC-SHA256 signature and compare using Timing-Safe Equality Checks
-    const calculatedSignature = crypto
-      .createHmac("sha256", secretKey)
-      .update(`${timestampHeader}.${rawBody}`)
-      .digest("hex");
-
-    const signatureBuffer = Buffer.from(signatureHeader, "utf8");
-    const calculatedBuffer = Buffer.from(calculatedSignature, "utf8");
-
-    if (signatureBuffer.length !== calculatedBuffer.length || !crypto.timingSafeEqual(signatureBuffer, calculatedBuffer)) {
-      throw new Error("Cryptographic Error: Webhook signature verification failed. Unauthorized payload origin.");
-    }
-
-    // 3. Parse and validate payload
-    const payload: WebhookPayload = JSON.parse(rawBody);
-    const {
-      tenantId,
-      partyId,
-      remittanceAmountMinor,
-      currency,
-      externalReference,
-      clearingAccountId,
-      receivablesAccountId,
-      walletAccountId = "2020-FLOATING-LIABILITIES"
-    } = payload;
-
-    if (!tenantId || !partyId || !externalReference || !clearingAccountId || !receivablesAccountId) {
-      throw new Error("Validation Error: Missing mandatory fields in payment webhook payload.");
-    }
-
-    if (typeof remittanceAmountMinor !== "number" || remittanceAmountMinor <= 0 || remittanceAmountMinor % 1 !== 0) {
-      throw new Error(`Validation Error: Remittance amount must be a positive integer in minor units. Received: ${remittanceAmountMinor}`);
-    }
-
-    // 4. Strong Idempotency Filter (SHA-256 hash of reference + tenant id to prevent double entry)
-    const idempotencyHash = crypto
-      .createHash("sha256")
-      .update(`${tenantId}:${externalReference}`)
-      .digest("hex");
-
-    const existingJournals = this.db.select<any>(
-      "journal_entries",
-      (j) => j.tenant_id === tenantId && j.hash_ref === idempotencyHash
-    );
-
-    if (existingJournals.length > 0) {
-      return {
-        success: true,
-        message: "Idempotency Triggered: This transaction reference was already processed and allocated.",
-        journalEntryId: existingJournals[0].id,
-        allocatedAmountMinor: 0,
-        overflowAmountMinor: 0,
-        allocatedItems: [],
-        walletCredited: false
-      };
-    }
-
-    // 5. Verify Party exists and is active inside the tenant workspace
-    const parties = this.db.select<any>(
-      "parties",
-      (p) => p.tenant_id === tenantId && p.id === partyId
-    );
-    if (parties.length === 0) {
-      throw new Error(`Execution Error: Party ID '${partyId}' not found within tenant workspace '${tenantId}'.`);
-    }
-    if (parties[0].status !== "ACTIVE") {
-      throw new Error(`Execution Error: Party '${partyId}' is not active. Status: ${parties[0].status}`);
-    }
-
-    // 6. Loop-driven FIFO (First-In, First-Out) Debt Clearing Mechanism
-    const openItems = this.db.select<any>(
-      "open_items",
-      (item) => item.tenant_id === tenantId && item.party_id === partyId && item.status !== "PAID" && item.status !== "VOIDED"
-    );
-
-    // Sort open items by due_date ascending, then created_at ascending (FIFO sequence)
-    openItems.sort((a, b) => {
-      const dateA = new Date(a.due_date).getTime();
-      const dateB = new Date(b.due_date).getTime();
-      if (dateA !== dateB) return dateA - dateB;
-      return new Date(a.created_at).getTime() - new Date(b.created_at).getTime();
-    });
-
-    let remainingRemittance = remittanceAmountMinor;
-    let totalAllocated = 0;
-    const allocatedItems: AllocatedItem[] = [];
-
-    // Systematically isolate unpaid open_items and deduct balances iteratively
-    for (const item of openItems) {
-      if (remainingRemittance <= 0) break;
-
-      const debtRemaining = item.amount_minor - item.allocated_amount_minor;
-      if (debtRemaining <= 0) continue;
-
-      if (remainingRemittance >= debtRemaining) {
