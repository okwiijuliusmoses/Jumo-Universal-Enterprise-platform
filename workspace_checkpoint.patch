-    }
-
-    // 8. Generate strict double-entry ledger lines
-    const journalId = `JRN-${crypto.randomUUID()}`;
-    const ledgerLines: LineInput[] = [];
-
-    // Line A: Debit Clearing Account (Asset) for the full remittance
-    ledgerLines.push({
-      accountId: clearingAccountId,
-      debit: remittanceAmountMinor,
-      credit: 0,
-      currency
-    });
-
-    // Line B: Credit Receivables Account (Asset) for the portion cleared
-    if (totalAllocated > 0) {
-      ledgerLines.push({
-        accountId: receivablesAccountId,
-        debit: 0,
-        credit: totalAllocated,
-        currency
-      });
-    }
-
-    // Line C: Credit Floating Overpayments Account (Liability) for residual balance
-    if (overpaymentMinor > 0) {
-      ledgerLines.push({
-        accountId: walletAccountId,
-        debit: 0,
-        credit: overpaymentMinor,
-        currency
-      });
-    }
-
-    // 9. Enforce mathematical integrity check using BalancerService
-    BalancerService.verifyParity(ledgerLines);
-
-    // 10. Persist transaction and updates atomically to ledger logs
-    this.db.insert<any>("journal_entries", {
-      id: journalId,
-      tenant_id: tenantId,
-      reference: externalReference,
-      hash_ref: idempotencyHash,
-      description: `Clearing execution for party ${partyId}. Allocated: ${totalAllocated} ${currency}, Residual Overpayment: ${overpaymentMinor} ${currency}`,
-      source: "PAYMENT_GATEWAY",
-      status: "POSTED",
-      created_at: new Date().toISOString()
-    });
-
-    for (const line of ledgerLines) {
-      const lineId = `LNL-${crypto.randomUUID()}`;
-      this.db.insert<any>("ledger_lines", {
-        id: lineId,
-        tenant_id: tenantId,
-        journal_entry_id: journalId,
-        ledger_account_id: line.accountId,
-        debit_minor: line.debit,
-        credit_minor: line.credit,
-        currency: line.currency,
-        created_at: new Date().toISOString()
-      });
-
-      // Synchronize in-memory/backup account balances
-      this.db.update<any>(
-        "ledger_accounts",
-        (acc) => acc.tenant_id === tenantId && acc.id === line.accountId,
-        (acc) => ({
-          ...acc,
-          balance_minor: acc.balance_minor + line.debit - line.credit
-        })
-      );
-    }
-
-    return {
-      success: true,
-      message: "Remittance allocated and ledger entries posted with verified zero parity.",
-      journalEntryId: journalId,
-      allocatedAmountMinor: totalAllocated,
-      overflowAmountMinor: overpaymentMinor,
-      allocatedItems,
-      walletCredited
-    };
-  }
-}
-export default PolymorphicAllocationEngine;
