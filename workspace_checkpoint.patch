-          })
-        );
-      }
-    }
-
-    // 7. Route any residual financial overflow (overpayment) directly to digital_wallets
-    let overpaymentMinor = 0;
-    let walletCredited = false;
-
-    if (remainingRemittance > 0) {
-      overpaymentMinor = remainingRemittance;
-      
-      const wallets = this.db.select<any>(
-        "digital_wallets",
-        (w) => w.tenant_id === tenantId && w.party_id === partyId
-      );
-
-      if (wallets.length > 0) {
-        this.db.update<any>(
-          "digital_wallets",
-          (w) => w.tenant_id === tenantId && w.party_id === partyId,
-          (w) => ({
-            ...w,
-            balance_minor: w.balance_minor + overpaymentMinor,
-            updated_at: new Date().toISOString()
-          })
-        );
-      } else {
-        const newWalletId = `WLT-${tenantId}-${partyId}`;
-        this.db.insert<any>("digital_wallets", {
-          id: newWalletId,
-          tenant_id: tenantId,
-          party_id: partyId,
-          balance_minor: overpaymentMinor,
-          currency: currency,
-          status: "ACTIVE",
-          updated_at: new Date().toISOString()
