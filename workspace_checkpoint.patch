-    FOREIGN KEY (tenant_id, journal_entry_id) REFERENCES journal_entries(tenant_id, id) ON DELETE CASCADE,
-    FOREIGN KEY (tenant_id, ledger_account_id) REFERENCES ledger_accounts(tenant_id, id) ON DELETE CASCADE,
-    
-    -- Absolute financial constraints:
-    CONSTRAINT chk_debit_non_negative CHECK (debit_minor >= 0),
-    CONSTRAINT chk_credit_non_negative CHECK (credit_minor >= 0),
-    CONSTRAINT chk_exclusivity CHECK (
-        (debit_minor > 0 AND credit_minor = 0) OR 
-        (debit_minor = 0 AND credit_minor > 0)
-    )
-);
-
--- ============================================================================
--- 3. FINANCIAL INTEGRITY TRIGGERS AND FUNCTIONS
--- ============================================================================
-
--- Function to retrieve the active tenant ID from session context
-CREATE OR REPLACE FUNCTION get_active_tenant_context()
-RETURNS VARCHAR AS $$
-BEGIN
-    RETURN COALESCE(current_setting('app.current_tenant_id', true), '');
-END;
-$$ LANGUAGE plpgsql;
-
--- Trigger to verify balance of journal entry before committing
-CREATE OR REPLACE FUNCTION verify_journal_balance()
-RETURNS TRIGGER AS $$
-DECLARE
-    v_total_debit BIGINT;
-    v_total_credit BIGINT;
-BEGIN
-    SELECT COALESCE(SUM(debit_minor), 0), COALESCE(SUM(credit_minor), 0)
-    INTO v_total_debit, v_total_credit
-    FROM ledger_lines
-    WHERE tenant_id = NEW.tenant_id AND journal_entry_id = NEW.id;
-
-    IF v_total_debit <> v_total_credit THEN
-        RAISE EXCEPTION 'Double-entry integrity violation: Total debits (%) must equal total credits (%) in journal entry %', 
-            v_total_debit, v_total_credit, NEW.id;
-    END IF;
-
-    RETURN NEW;
-END;
-$$ LANGUAGE plpgsql;
-
--- Trigger to update account balance on ledger lines insertion
-CREATE OR REPLACE FUNCTION update_account_balance()
-RETURNS TRIGGER AS $$
-BEGIN
-    IF TG_OP = 'INSERT' THEN
-        UPDATE ledger_accounts
-        SET balance_minor = balance_minor + NEW.debit_minor - NEW.credit_minor
-        WHERE tenant_id = NEW.tenant_id AND id = NEW.ledger_account_id;
-    ELSIF TG_OP = 'DELETE' THEN
-        UPDATE ledger_accounts
-        SET balance_minor = balance_minor - OLD.debit_minor + OLD.credit_minor
-        WHERE tenant_id = OLD.tenant_id AND id = OLD.ledger_account_id;
-    END IF;
-    RETURN NULL;
-END;
-$$ LANGUAGE plpgsql;
-
-CREATE TRIGGER trg_update_account_balance
-AFTER INSERT OR DELETE ON ledger_lines
-FOR EACH ROW EXECUTE FUNCTION update_account_balance();
-
--- ============================================================================
--- 4. ROW LEVEL SECURITY (RLS) MULTI-TENANT ISOLATION POLICIES
--- ============================================================================
-
--- Enable RLS on all tables
-ALTER TABLE tenants ENABLE ROW LEVEL SECURITY;
-ALTER TABLE parties ENABLE ROW LEVEL SECURITY;
-ALTER TABLE party_metadata ENABLE ROW LEVEL SECURITY;
-ALTER TABLE ledger_accounts ENABLE ROW LEVEL SECURITY;
-ALTER TABLE open_items ENABLE ROW LEVEL SECURITY;
-ALTER TABLE digital_wallets ENABLE ROW LEVEL SECURITY;
-ALTER TABLE journal_entries ENABLE ROW LEVEL SECURITY;
-ALTER TABLE ledger_lines ENABLE ROW LEVEL SECURITY;
-
--- Tenants Policy
-CREATE POLICY tenants_rls_policy ON tenants
-    FOR ALL 
-    USING (id = get_active_tenant_context());
-
--- Parties Policy
-CREATE POLICY parties_rls_policy ON parties
-    FOR ALL 
-    USING (tenant_id = get_active_tenant_context());
-
--- Party Metadata Policy
-CREATE POLICY party_metadata_rls_policy ON party_metadata
-    FOR ALL 
-    USING (tenant_id = get_active_tenant_context());
-
--- Ledger Accounts Policy
-CREATE POLICY ledger_accounts_rls_policy ON ledger_accounts
-    FOR ALL 
-    USING (tenant_id = get_active_tenant_context());
-
--- Open Items Policy
-CREATE POLICY open_items_rls_policy ON open_items
-    FOR ALL 
-    USING (tenant_id = get_active_tenant_context());
-
--- Digital Wallets Policy
-CREATE POLICY digital_wallets_rls_policy ON digital_wallets
-    FOR ALL 
-    USING (tenant_id = get_active_tenant_context());
-
--- Journal Entries Policy
-CREATE POLICY journal_entries_rls_policy ON journal_entries
-    FOR ALL 
-    USING (tenant_id = get_active_tenant_context());
-
--- Ledger Lines Policy
-CREATE POLICY ledger_lines_rls_policy ON ledger_lines
-    FOR ALL 
-    USING (tenant_id = get_active_tenant_context());
