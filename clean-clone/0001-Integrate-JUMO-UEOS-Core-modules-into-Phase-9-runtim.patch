+          "region": "europe-west1"
+        }
+      },
+      {
+        "source": "/domain/**",
+        "run": {
+          "serviceId": "jumo-ueos-core",
+          "region": "europe-west1"
+        }
+      },
+      {
+        "source": "/owner",
+        "run": {
+          "serviceId": "jumo-ueos-core",
+          "region": "europe-west1"
+        }
+      },
+      {
+        "source": "/dashboard",
+        "run": {
+          "serviceId": "jumo-ueos-core",
+          "region": "europe-west1"
+        }
+      },
+      {
+        "source": "**",
+        "destination": "/index.html"
+      }
+    ]
