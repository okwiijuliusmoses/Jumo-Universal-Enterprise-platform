+      const btnAddDoc = document.getElementById('btn-add-doc');
+      const btnMfa = document.getElementById('btn-mfa');
+      const btnExportBackup = document.getElementById('btn-export-backup');
+
+      // Command line engine simulator
+      function printLine(text, colorClass = 'text-slate-300') {
+        const line = document.createElement('div');
+        line.className = colorClass;
+        line.textContent = text;
+        termScreen.appendChild(line);
+        termScreen.scrollTop = termScreen.scrollHeight;
+      }
+
+      termInput.addEventListener('keydown', async (e) => {
+        if (e.key === 'Enter') {
+          const cmd = termInput.value.trim();
+          termInput.value = '';
+          if (!cmd) return;
+
+          printLine(`ueos-admin@root:~$ ${cmd}`, 'text-teal-400 font-bold');
+
+          const parts = cmd.toLowerCase().split(' ');
+          const base = parts[0];
+
+          if (base === 'help') {
+            printLine('Available Commands:');
+            printLine('  help                 - Display administrative command spectrum');
+            printLine('  scan                 - Conduct a comprehensive SecOps threat scan');
+            printLine('  status               - Query operational host node diagnostic stats');
+            printLine('  compliance           - Fetch certified continuous ledger compliance audits');
+            printLine('  clear                - Flush terminal history cache');
+          } else if (base === 'clear') {
+            termScreen.innerHTML = '';
+          } else if (base === 'scan') {
+            printLine('Contacting JUMO AEGIS Security Router Shield...', 'text-slate-500');
+            try {
+              const res = await window.apiClient.triggerSecurityScan();
+              if (res && res.success) {
+                printLine(`Scan ID: ${res.scanId}`, 'text-teal-400 font-bold');
+                printLine(`Compliance Status: ${res.complianceStatus}`, 'text-emerald-400');
+                printLine(`Security Score: ${res.securityScore}`, 'text-emerald-400');
+                printLine(`Report: ${res.aiSecurityReport}`);
+                printLine(`Recommendation: ${res.recommendation}`, 'text-amber-400 font-semibold');
+              }
+            } catch (err) {
+              printLine(`Error during threat scan: ${err.message}`, 'text-rose-400');
+            }
+          } else if (base === 'compliance') {
+            printLine('Fetching ledger audit balances and compliance summaries...', 'text-slate-500');
+            try {
+              const res = await window.apiClient.getComplianceReport();
+              if (res && res.success) {
+                printLine(`Certified At: ${res.certifiedAt}`, 'text-emerald-400');
+                printLine(`Compliance Score: ${res.score}`, 'text-teal-400 font-bold');
+                res.criteriaEvaluations.forEach(ev => {
+                  printLine(`  [${ev.status}] ${ev.name} - ${ev.details}`, 'text-slate-400');
+                });
+              }
+            } catch (err) {
+              printLine(`Error: ${err.message}`, 'text-rose-400');
+            }
+          } else if (base === 'status') {
+            printLine('[DIAG-HOST] Active replications: 100% healthy.');
+            printLine('[DIAG-HOST] Memory cluster: 124.8MB isolated cache.');
+            printLine('[DIAG-HOST] Database engine: pg-pool client connected.');
+          } else {
+            printLine(`Command not found: "${base}". Type "help" for instructions.`, 'text-rose-400');
+          }
+        }
+      });
+
+      // Index doc to RAG
+      btnAddDoc.addEventListener('click', async () => {
+        const title = docTitle.value.trim();
+        const category = docCategory.value.trim();
+        const content = docContent.value.trim();
+
+        if (!title || !content) {
+          alert('Document title and content grounding text are required.');
+          return;
+        }
+
+        btnAddDoc.disabled = true;
+        btnAddDoc.textContent = 'Indexing...';
+
+        try {
+          const res = await window.apiClient.request('/api/ueos/rag/add-document', {
+            method: 'POST',
+            body: JSON.stringify({
+              title,
+              category,
+              content,
+              tenantScope: 'JUMO-HQ-01',
+              minimumClearance: 'Standard'
+            })
+          });
+
+          if (res && res.success) {
+            printLine(`[RAG-INDEX] Indexed document "${title}" successfully into knowledge registries.`, 'text-emerald-400');
+            docTitle.value = '';
+            docCategory.value = '';
+            docContent.value = '';
+            alert('Document indexed successfully!');
+          }
+        } catch (err) {
+          alert('Failed to index document: ' + err.message);
+        } finally {
+          btnAddDoc.disabled = false;
+          btnAddDoc.textContent = 'Index Document to RAG Vault';
+        }
+      });
+
+      // MFA simulation
+      btnMfa.addEventListener('click', () => {
+        const user = window.apiClient.getCurrentUser() || { email: 'admin' };
+        alert(`SecOps Signature Challenge:\nMFA crypt-token successfully pushed to authorized cell channel of ${user.email}. Signature validated!`);
+        printLine('[SECOPS] Multi-factor authentication signature verified. Clearance valid for 30 minutes.', 'text-emerald-400');
+      });
+
+      // Backup snapshot
+      btnExportBackup.addEventListener('click', () => {
+        alert('Sealed database schema and double-entry transaction histories backed up successfully!\nSaved snapshot: /assets/ueos_database_snapshot.json');
+        printLine('[BACKUP] Database partition snapshot generated and sealed successfully.', 'text-teal-400');
+      });
+    });
+  </script>
+</body>
+</html>
diff --git a/experience/public/experience/services/apiClient.js b/experience/public/experience/services/apiClient.js
new file mode 100644
index 0000000..55dc58b
--- /dev/null
+++ b/experience/public/experience/services/apiClient.js
@@ -0,0 +1,146 @@
+/**
+ * JUMO Universal Enterprise Operating System (UEOS)
+ * experience/services/apiClient.js
+ * 
+ * Production-grade vanilla JS API client interface for JUMO UEOS.
+ * Connects the Experience Layer with the Sovereign Core Micro-Kernel APIs.
+ */
+
+if (typeof window !== 'undefined') {
+  const isFirebase = window.location.hostname.includes('web.app') || window.location.hostname.includes('firebaseapp.com');
+  if (isFirebase) {
+    const originalFetch = window.fetch;
+    window.fetch = function(input, init) {
+      if (typeof input === 'string' && input.startsWith('/api/')) {
+        const targetUrl = 'https://jumo-ueos-dhp-production-production.up.railway.app' + input;
+        const newInit = {
+          ...init,
+          mode: 'cors'
+        };
+        return originalFetch(targetUrl, newInit);
+      }
+      return originalFetch(input, init);
+    };
+  }
+}
+
+class JumoApiClient {
+  constructor(baseUrl = '') {
+    this.baseUrl = baseUrl;
+  }
+
+  async request(endpoint, options = {}) {
+    const url = `${this.baseUrl}${endpoint}`;
+    const headers = {
+      'Content-Type': 'application/json',
+      ...options.headers,
+    };
+
+    try {
+      const response = await fetch(url, {
+        ...options,
+        headers,
+      });
+
+      const data = await response.json();
+      if (!response.ok) {
+        throw new Error(data.error || `HTTP error! Status: ${response.status}`);
+      }
+      return data;
+    } catch (error) {
+      console.error(`JUMO API Client Error [${endpoint}]:`, error);
+      throw error;
+    }
+  }
+
+  // Identity & Auth
+  async login(email, role = 'SecOps_Administrator') {
+    // Standard mock session handler for experience layer authentication flow
+    const mockUser = {
+      email,
+      name: email.split('@')[0],
+      role,
+      tenantId: 'JUMO-HQ-01',
+      trustLevel: 'L4_High_Trust',
+    };
+    localStorage.setItem('jumo_current_user', JSON.stringify(mockUser));
+    return { success: true, user: mockUser };
+  }
+
+  getCurrentUser() {
+    try {
+      const userStr = localStorage.getItem('jumo_current_user');
+      return userStr ? JSON.parse(userStr) : null;
+    } catch (e) {
+      return null;
+    }
+  }
+
+  logout() {
+    localStorage.removeItem('jumo_current_user');
+  }
+
+  // Threat & Compliance Reports
+  async getComplianceReport() {
+    return this.request('/api/ueos/governance/compliance-report');
+  }
+
+  async getSecurityThreats() {
+    return this.request('/api/ueos/security/threats');
+  }
+
+  async triggerSecurityScan() {
+    return this.request('/api/ueos/security/threat-scan', { method: 'POST' });
+  }
+
+  // Live v1 Platform API Integrations
+  async getPlatformStatus() {
+    return this.request('/api/v1/platform/status');
+  }
+
+  async getTreasurySummary() {
+    return this.request('/api/v1/treasury/summary');
+  }
+
+  async getSecurityEvents() {
+    return this.request('/api/v1/security/events');
+  }
+
+  async getWorkflowStatus() {
+    return this.request('/api/v1/workflow/status');
+  }
+
+  async getDomains() {
+    return this.request('/api/v1/domains');
+  }
+
+  // AI Orchestration Swarms
+  async getWorkflows() {
+    return this.request('/api/ueos/ai/orchestration-workflows');
+  }
+
+  async triggerSwarm(goal, tenantId = 'JUMO-HQ-01') {
+    return this.request('/api/ueos/ai/trigger-swarm', {
+      method: 'POST',
+      body: JSON.stringify({ goal, tenantId }),
+    });
+  }
+
+  // Marketplace plugins
+  async getMarketplaceCatalog() {
+    return this.request('/api/ueos/marketplace/catalog');
+  }
+
+  async installPlugin(pluginId, tenantId = 'JUMO-HQ-01') {
+    return this.request('/api/ueos/marketplace/install', {
+      method: 'POST',
+      body: JSON.stringify({ pluginId, tenantId }),
+    });
+  }
+}
+
+// Export singleton instance
+const apiClient = new JumoApiClient();
+if (typeof window !== 'undefined') {
+  window.apiClient = apiClient;
+}
