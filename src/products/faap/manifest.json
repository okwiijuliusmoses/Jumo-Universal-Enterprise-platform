{
  "productIdentity": {
    "productId": "PROD_FAAP",
    "name": "JUMO FAAP",
    "version": "1.0.4",
    "type": "STANDALONE_ERP",
    "tagline": "Financial Accounting & Administrative Platform",
    "author": "JUMO Software Ltd"
  },
  "runtime": {
    "nodeVersion": ">=18.0.0",
    "database": "PostgreSQL 14+ / Cloud SQL / Local Storage",
    "pwaSupport": true
  },
  "offices": [
    { "id": "OFF_FAAP_GL", "label": "General Ledger & Chart of Accounts" },
    { "id": "OFF_FAAP_VOTE", "label": "Vote Book & Pre-Expenditure Encumbrances" },
    { "id": "OFF_FAAP_BUDGET", "label": "Annual Budget Book & Variance Monitor" },
    { "id": "OFF_FAAP_CASH", "label": "Single, Double & Triple Column Cash Books" },
    { "id": "OFF_FAAP_AP_AR", "label": "Accounts Payable & Accounts Receivable" },
    { "id": "OFF_FAAP_BANK", "label": "Commercial Bank Reconciliation & Treasury" },
    { "id": "OFF_FAAP_AUDIT", "label": "Auditor Working Papers & Financial Analytics" }
  ],
  "installationHooks": {
    "migration": "npm run db:migrate",
    "seed": "npm run db:seed:faap",
    "healthCheck": "/api/faap/health"
  }
}
