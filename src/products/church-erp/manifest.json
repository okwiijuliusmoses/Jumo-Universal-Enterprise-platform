{
  "productIdentity": {
    "productId": "PROD_CH",
    "name": "JUMO Church & Diocese ERP",
    "version": "1.0.4",
    "type": "STANDALONE_ERP",
    "tagline": "Universal Ecclesiastical & Parish Operating System",
    "author": "JUMO Software Ltd"
  },
  "runtime": {
    "nodeVersion": ">=18.0.0",
    "database": "PostgreSQL 14+ / Cloud SQL / Local Storage",
    "pwaSupport": true
  },
  "offices": [
    { "id": "OFF_CH_PARISH", "label": "Parish & Congregation Administration" },
    { "id": "OFF_CH_SACRAMENT", "label": "Sacramental Registry (Baptism, Matrimony)" },
    { "id": "OFF_CH_CLERGY", "label": "Clergy, Pastoral Care & Ministries" },
    { "id": "OFF_CH_FINANCE", "label": "Tithes, Offertory & Project Accounting" },
    { "id": "OFF_CH_COMM", "label": "Ecclesiastical Governance & Communications" }
  ],
  "installationHooks": {
    "migration": "npm run db:migrate",
    "seed": "npm run db:seed:church",
    "healthCheck": "/api/church-erp/health"
  }
}
