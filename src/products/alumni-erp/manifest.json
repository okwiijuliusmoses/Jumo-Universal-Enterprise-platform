{
  "productIdentity": {
    "productId": "PROD_ALUMNI",
    "name": "JUMO Alumni ERP",
    "version": "1.0.4",
    "type": "STANDALONE_ERP",
    "tagline": "Institutional Advancement & Alumni Platform",
    "author": "JUMO Software Ltd"
  },
  "runtime": {
    "nodeVersion": ">=18.0.0",
    "database": "PostgreSQL 14+ / Cloud SQL / Local Storage",
    "pwaSupport": true
  },
  "offices": [
    { "id": "OFF_ALU_MEMBER", "label": "Alumni Member Registry & Profiles" },
    { "id": "OFF_ALU_CARD", "label": "Digital Identity & QR Scanner" },
    { "id": "OFF_ALU_CHAPTER", "label": "Regional Chapters & Directory" },
    { "id": "OFF_ALU_GIVING", "label": "Advancement & Endowment Fund" },
    { "id": "OFF_ALU_CAREER", "label": "Mentorship, Jobs & Opportunities" }
  ],
  "installationHooks": {
    "migration": "npm run db:migrate",
    "seed": "npm run db:seed:alumni",
    "healthCheck": "/api/alumni-erp/health"
  }
}
