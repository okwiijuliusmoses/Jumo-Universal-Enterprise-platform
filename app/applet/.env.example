# JUMO UEOS — Environment Configuration Example
# Copy this file to .env and configure for your deployment.

# AI Provider Routing Mode ('air-gap' | 'hybrid' | 'cloud')
AI_PROVIDER_MODE=hybrid

# Local Inference Runtime (Ollama / vLLM / llama.cpp)
JUMO_LOCAL_RUNTIME_ENABLED=true
JUMO_LOCAL_RUNTIME_TYPE=ollama
JUMO_LOCAL_OLLAMA_URL=http://127.0.0.1:11434
JUMO_LOCAL_MODEL=qwen2.5:7b
JUMO_LOCAL_MODEL_FALLBACK=qwen2.5:3b

# External Cloud Provider Credentials (Stored Securely in Server-Side Vault)
OPENAI_API_KEY=sk-proj-placeholder-key-replace-with-actual-secret
GEMINI_API_KEY=AIzaSy-placeholder-key-replace-with-actual-secret

# Database & Server Settings
PORT=3000
NODE_ENV=production
