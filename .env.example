# ==============================================================================
# JUMO Universal Enterprise Operating System (UEOS) Production Environment Template
# ==============================================================================
# This template defines all required environment variables for the production and
# hybrid deployment of the JUMO UEOS platform. 
# 
# RULES FOR IMPLEMENTATION:
# 1. Never hard-code production secrets or tokens in the codebase.
# 2. Never commit actual passwords, private keys, or credentials to git repositories.
# 3. Always reference values using process.env.<VARIABLE_NAME> inside server-side code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SYSTEM RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# NODE_ENV: Defines the execution environment. Options: development, production
NODE_ENV=production

# PORT: The port on which the Express web server binds (defaults to 3000)
PORT=3000

# APP_URL: The canonical URL where this applet/service is hosted.
# Used for absolute URL generation, OAuth redirect callbacks, and dynamic routing.
APP_URL=https://your-jumo-ueos-domain.com

# ------------------------------------------------------------------------------
# 2. COGNITIVE AI GATEWAY CONFIGURATIONS (Multi-Provider Registry Abstraction)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for core Gemini AI API features (Google GenAI SDK).
# Obtain from Google AI Studio / Google Cloud Console.
GEMINI_API_KEY=your_gemini_api_key_here

# OPENAI_API_KEY: Optional. For OpenAI Proxy service integrations.
# Obtain from OpenAI Developer platform.
OPENAI_API_KEY=your_openai_api_key_here

# DEEPSEEK_API_KEY: Optional. For local deepseek edge models or deepseek API endpoints.
# Obtain from DeepSeek Developer platform.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ------------------------------------------------------------------------------
# 3. DATABASE ENGINE & PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# DB_TYPE: The storage engine used by JUMO repositories.
# Options: JSON, POSTGRESQL, CLOUD_SQL, FIREBASE
DB_TYPE=JSON

# DATABASE_URL: Required if DB_TYPE is POSTGRESQL or CLOUD_SQL.
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL=postgresql://jumo_operator:secure_db_password_here@localhost:5432/jumo_ueos_production

# FIREBASE CONFIGURATIONS: Required if DB_TYPE is FIREBASE.
# Base64 encoded or direct service account credentials for Firestore access.
FIREBASE_PROJECT_ID=jumo-ueos-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@jumo-ueos-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# FIREBASE_TOKEN: Required for CI/CD or platform command line deployments to Firebase Hosting.
# Generate this token locally using 'firebase login:ci' and paste it in the platform settings.
FIREBASE_TOKEN=your_firebase_token_here

# ------------------------------------------------------------------------------
# 4. ZERO-TRUST SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# SECURE_TOKEN_SECRET: Key used to sign JWT or multi-tenant sessions tokens.
# Generate a highly secure random 256-bit key in production.
SECURE_TOKEN_SECRET=generate_a_secure_random_hex_for_signature_here

# SECURE_ENCRYPTION_KEY: Key used to encrypt tenant-isolated data blocks.
# Generate a 32-character key for AES-256 encryption.
SECURE_ENCRYPTION_KEY=your_32_character_encryption_key_here
ENCRYPTION_KEY=your_32_character_encryption_key_here

# TENANT_ISOLATION_MODE: Enforces the cryptographic tenant segmentation boundary.
# Options: ROW_LEVEL_STRICT, COGNITIVE_SANDBOX_STRICT
TENANT_ISOLATION_MODE=ROW_LEVEL_STRICT
